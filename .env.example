# gakhalmo-back — environment template.
#
# 운영 원칙:
# - 로컬 개발: 이 파일을 `.env`로 복사 후 필수 값만 채움.
# - dev/prod: 이 파일은 참고용. 실제 값은 K8s Secret/ConfigMap에서 주입.
#   → deploy/k8s/secret.example.yaml 참조.
# - 공개 상수(Google OAuth 엔드포인트 URL 등)는 env에 두지 않음.
#   코드에서 import: app.domain.auth.google_constants
#
# ─── Runtime environment ──────────────────────────────────────────────
# One of: local | test | dev | prod
# dev/prod는 DEBUG/localhost DB/HTTP redirect를 거부.
ENV=local

# ─── Required secrets (default 없음 — 누락 시 부팅 실패) ────────────────
# DATABASE_URL: MySQL async driver (asyncmy) 필수.
DATABASE_URL=mysql+asyncmy://gakhalmo:<set-me>@10.0.86.154:3306/gakhalmo_dev

# JWT_SECRET: ≥32 bytes. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Google OAuth credentials (Google Cloud Console에서 발급).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Application ──────────────────────────────────────────────────────
DATABASE_ECHO=false
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Comma-separated origins (e.g. https://gakhalmo.kr,https://admin.gakhalmo.kr)
CORS_ORIGINS=

# ─── JWT tunables ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ─── Security knobs ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Google OAuth (env-specific, 비시크릿) ─────────────────────────────
# REDIRECT_URI는 환경마다 다름 — local=http, dev/prod=https.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OAuth state (CSRF) TTL — 초.
OAUTH_STATE_TTL_SECONDS=600

# Google 로그인 이메일이 기존 로컬 계정과 일치할 때 자동 연결 여부.
# 프로덕션은 false 고정 (명시적 link 플로우 요구).
AUTH_ALLOW_GOOGLE_AUTOLINK=false

# ─── Startup behaviour ────────────────────────────────────────────────
# 부팅 시 지역 시드 실행 여부. prod=false (dedicated Job 사용).
RUN_STARTUP_SEED=true
